# Copy to .env and fill in. Never commit .env.
SV_DATA_ROOT=
SV_DATA_TOKEN=
# Leave empty locally: results go to api/cache/store.json. Set only for Tiger Data.
DATABASE_URL=
# The AI chain: OpenAI first when OPENAI_KEY is set, Gemini second.
OPENAI_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
# ElevenLabs text-to-speech for ▶ PLAY (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# JSON store path when DATABASE_URL is unset or unreachable (default: api/cache/store.json)
CREW_STORE_PATH=
